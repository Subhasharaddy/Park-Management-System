
# ==========================================
# PARK MANAGEMENT SYSTEM
# GitHub Security and File Exclusions
# ==========================================

# ---------- PYTHON ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------- VIRTUAL ENVIRONMENTS ----------
venv/
.venv/
env/
ENV/
virtualenv/

# ---------- ENVIRONMENT VARIABLES & SECRETS ----------
.env
.env.*
!.env.example
!.env.template

# Secret keys
instance/.secret_key
instance/demo_credentials.txt
secrets/
*.pem
*.key
*.p12
*.pfx

# ---------- DATABASE & MYSQL ----------
*.db
*.sqlite
*.sqlite3
*.sqlitedb

# MySQL dumps and backups
*.sql.gz
*.dump
*.bak

# Keep the database schema for project setup
!schema.sql
!database/schema.sql

# ---------- USER UPLOADS ----------
# Private citizen complaint photographs
static/uploads/*
!static/uploads/.gitkeep

# ---------- LOGS ----------
*.log
logs/
flask.log
error.log

# ---------- TESTING & COVERAGE ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
test-results/

# ---------- EDITORS ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OPERATING SYSTEM ----------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- NODE / FRONTEND ----------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- TEMPORARY FILES ----------
*.tmp
*.temp
*.cache
*.old
*.orig

# ---------- BACKUPS ----------
*.zip
*.rar
*.7z

# ---------- KEEP PROJECT ASSETS ----------
# Your public design images should be uploaded.
# Keep static/images/ tracked.
# Your CSS, JavaScript, HTML and Python source files
# should remain tracked.
