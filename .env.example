# Copy to .env and fill in. NEVER commit .env.
SECRET_KEY=                 # optional; if empty a random key is generated in instance/.secret_key
DB_BACKEND=mysql            # mysql (default) | sqlite (offline demo only)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=parkcare
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=parkcare_db

# First admin created by `python init_db.py` (leave password empty to auto-generate one)
ADMIN_NAME=Park Administrator
ADMIN_EMAIL=admin@parkcare.local
ADMIN_PASSWORD=

# Default map centre used on the report form (latitude / longitude)
MAP_DEFAULT_LAT=12.9716
MAP_DEFAULT_LNG=77.5946

# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false
